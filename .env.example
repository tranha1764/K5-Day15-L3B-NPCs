# Chép file này thành .env rồi bỏ dấu # ở ĐÚNG MỘT khối provider bên dưới và điền key:
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# Hướng dẫn chi tiết: docs/connect-model.md

# --- Mặc định (để trống = chế độ giả `fake`, chưa gọi model thật) ---
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# BASE_URL=

# =====================================================================
# 1. Google Gemini (Google AI Studio)
# =====================================================================
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-2.5-flash
# API_KEY=AIza...

# =====================================================================
# 2. OpenAI
# =====================================================================
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# API_KEY=sk-...

# =====================================================================
# 3. OpenAI-compatible (Groq / DeepSeek / OpenRouter...) — cần thêm BASE_URL
# =====================================================================
# --- Groq ---
# MODEL_PROVIDER=groq
# MODEL_NAME=llama-3.3-70b-versatile
# API_KEY=gsk_...
# BASE_URL=https://api.groq.com/openai/v1/chat/completions

# --- DeepSeek ---
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-chat
# API_KEY=sk-...
# BASE_URL=https://api.deepseek.com/v1/chat/completions

# --- OpenRouter ---
# MODEL_PROVIDER=openrouter
# MODEL_NAME=google/gemini-2.5-flash
# API_KEY=sk-or-...
# BASE_URL=https://openrouter.ai/api/v1/chat/completions

# =====================================================================
# 4. Anthropic (Claude)
# =====================================================================
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-4-5-20251001
# API_KEY=sk-ant-...

# =====================================================================
# 5. Ollama (chạy model trên máy — không cần API_KEY)
# =====================================================================
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen2.5:7b
# API_KEY=
# BASE_URL=http://localhost:11434/api/chat

